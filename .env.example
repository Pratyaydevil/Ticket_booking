# ---- TicketBox environment ----------------------------------------------
# Copy to .env for local dev. Every value has a safe default in app/config.py.

# Security — set a long random string in production
SECRET_KEY=change-me-to-a-long-random-string

# Database — SQLite file by default; use Postgres in production
# DATABASE_URL=postgresql://user:pass@host:5432/ticketbox
DATABASE_URL=sqlite:///./tbs.db

# Seat hold & waitlist timing (seconds)
SEAT_HOLD_TTL_SECONDS=600         # how long a checkout hold lasts (10 min)
WAITLIST_OFFER_TTL_SECONDS=900    # how long a waitlist offer stays valid (15 min)
SWEEP_INTERVAL_SECONDS=10         # background sweeper cadence

# Email
# console = print + write emails/QRs to ./outbox (no credentials needed)
# smtp    = real delivery via any free-tier SMTP (Brevo, Mailtrap, Gmail app password)
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=tickets@ticketbox.dev

# Public URL of the app — used to build waitlist offer links in emails
BASE_URL=http://localhost:8000
